#!/bin/sh
# tsppc package preflight. Installer runs it as root before the payload, on
# every install and upgrade, with $1 the package, $2 the install location,
# $3 the target volume and $4 the system root.
# It stops a running tsppcd, so an upgrade never replaces the files under a
# running daemon. Uses only tools on both 10.4 and 10.5.
PLIST=/Library/LaunchDaemons/com.github.ajthom90.tsppcd.plist
WAIT_SEC=30

# The pids of processes named exactly tsppcd. Not ps -p: on Tiger it
# succeeds for a pid that is gone.
tsppcd_pids() {
    ps axc -o pid,command | awk 'NR > 1 && $2 == "tsppcd" { printf "%s%s", s, $1; s = " " }'
}

if [ "${3:-}" != "/" ]; then
    echo "tsppc installs only on the startup disk, not on ${3:-an unknown volume}." >&2
    exit 1
fi

# unsafe_dir <dir> <strict>: print why a directory the payload installs into is
# unsafe, or nothing. A missing one is fine (the payload creates it root:wheel
# 755). It must not be a symlink, must be root-owned, and must not be writable
# by others; with strict = 1 not by its group either.
unsafe_dir() {
    [ -L "$1" ] && { echo "$1 is a symlink"; return; }
    [ -e "$1" ] || return
    [ -d "$1" ] || { echo "$1 is not a directory"; return; }
    info=$(stat -f '%u %Lp' "$1" 2>/dev/null)
    [ -n "$info" ] || { echo "cannot stat $1"; return; }
    uid=${info% *}
    mode=${info#* }
    [ "$uid" = 0 ] || { echo "$1 is not owned by root"; return; }
    case "$mode" in ''|*[!0-7]*) echo "cannot read the mode of $1"; return ;; esac
    m=$((0$mode))
    [ $((m & 2)) = 0 ] || { echo "$1 is writable by others"; return; }
    if [ "$2" = 1 ] && [ $((m & 16)) != 0 ]; then echo "$1 is writable by its group"; fi
}

bad=0
for d in /usr/local:1 /usr/local/bin:1 /usr/local/sbin:1 /Library/LaunchDaemons:0 /Library/Extensions:0; do
    why=$(unsafe_dir "${d%:*}" "${d##*:}")
    if [ -n "$why" ]; then
        echo "tsppc cannot be installed safely: $why. Fix it and install again." >&2
        bad=1
    fi
done
[ "$bad" = 0 ] || exit 1

if [ -f "$PLIST" ]; then
    launchctl unload "$PLIST" || echo "preflight: launchctl unload $PLIST failed; checking for tsppcd anyway" >&2
fi

waited=0
while :; do
    pids=$(tsppcd_pids)
    [ -z "$pids" ] && break
    if [ "$waited" -ge "$WAIT_SEC" ]; then
        echo "tsppcd is still running (pid $pids) after ${WAIT_SEC}s; stop it and install again." >&2
        exit 1
    fi
    sleep 1
    waited=$((waited + 1))
done
exit 0
