#!/bin/sh
# tsppc package postflight. Installer runs it as root after the payload.
# It starts the daemon now (it also starts at every boot) and, for an install
# from the Installer app, opens the menu bar app for the user at the console.
# Nothing here fails the install: the files are in place by now.
PLIST=/Library/LaunchDaemons/com.github.ajthom90.tsppcd.plist
APP=/Applications/tsppc.app

launchctl load -w "$PLIST" || echo "postflight: launchctl load -w $PLIST failed; tsppcd starts at the next boot" >&2

if [ -z "${COMMAND_LINE_INSTALL:-}" ] && [ -d "$APP" ]; then
    user=$(stat -f %Su /dev/console 2>/dev/null)
    case "$user" in
    ''|root|*[!A-Za-z0-9._-]*) ;;
    *) sudo -u "$user" /usr/bin/open "$APP" || echo "postflight: could not open $APP for $user" >&2 ;;
    esac
fi
exit 0
